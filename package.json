{
  "name": "nodeset-js",
  "version": "0.1.0",
  "description": "Graphical modeler for OPC UA information models: types and instances in the notation of OPC 10000-3 Annex C, stored as NodeSet2.",
  "license": "MIT",
  "author": "Hamied Nabizada",
  "homepage": "https://github.com/HamiedNabizada/NodeSet.js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HamiedNabizada/NodeSet.js.git"
  },
  "bugs": {
    "url": "https://github.com/HamiedNabizada/NodeSet.js/issues"
  },
  "keywords": [
    "opc-ua",
    "nodeset",
    "nodeset2",
    "information-model",
    "modeler",
    "caex",
    "diagram-js"
  ],
  "type": "commonjs",
  "scripts": {
    "dev": "webpack serve --config webpack.config.js --mode development",
    "build": "npm run build:web && npm run build:lib",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:web && playwright test",
    "build:web": "webpack --config webpack.config.js --mode production",
    "build:lib": "webpack --config webpack.lib.config.js --mode production && tsc -p tsconfig.lib.json",
    "verify:core": "node scripts/verify-core.cjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.5",
    "happy-dom": "^20.14.5",
    "html-webpack-plugin": "^5.6.8",
    "style-loader": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "webpack": "^5.111.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.6"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "diagram-js": "^15.26.0",
    "min-dash": "^5.1.0",
    "min-dom": "^5.3.0",
    "react": ">=18",
    "react-dom": ">=18",
    "tiny-svg": "^4.1.4"
  },
  "main": "dist/lib/nodeset.umd.js",
  "module": "dist/lib/nodeset.esm.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lib/nodeset.esm.js",
      "require": "./dist/lib/nodeset.umd.js"
    },
    "./core": {
      "types": "./dist/types/core.d.ts",
      "import": "./dist/lib/nodeset.core.mjs",
      "require": "./dist/lib/nodeset.core.cjs"
    }
  },
  "files": [
    "dist/lib",
    "dist/types",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
